# Wohin Kontaktformular und Marketing-Check-Leads gehen (n8n-Webhook «Website-Kontakt (alperna.ch)»).
# Ohne Wert antworten /api/kontakt und /api/lead mit 503.
N8N_WEBHOOK_URL=

# KI-Einschätzung im Marketing-Check über das Vercel AI Gateway.
# Auf Vercel meldet sich die Funktion selbst an (OIDC). Lokal braucht es einen Schlüssel.
# Ohne Zugang erscheint das Ergebnis ohne KI-Abschnitt.
AI_GATEWAY_API_KEY=
# Modelle in der Reihenfolge der Prüfung, kommagetrennt, höchstens vier. Standard: mistral/mistral-large-3,anthropic/claude-haiku-4.5
AI_MODELS=

# Optional: genauere Prüfung des Google-Profils im Marketing-Check (Places API).
GOOGLE_PLACES_API_KEY=

# Erst beim Go-live auf 1 setzen. Sonst bleibt die Seite für Suchmaschinen gesperrt.
NEXT_PUBLIC_INDEXABLE=
